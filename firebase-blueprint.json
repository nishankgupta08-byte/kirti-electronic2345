{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Electronic product entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "specs": { "type": "object" },
        "stock": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "price", "category", "stock"]
    }
  },
  "firestore": {
    "products": {
      "schema": "Product",
      "description": "Collection of electronic products"
    }
  }
}
