rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin check function:
    // This checks if a document exists in the 'admins' collection with the user's UID
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Approved retailer check:
    function isApprovedRetailer() {
      return request.auth != null &&
             get(/databases/$(database)/documents/retailers/$(request.auth.uid)).data.isApproved == true;
    }

    match /products/{id} {
      allow read: if true;                 // Public can browse hardware
      allow write: if isAdmin();           // Only administrative clearance can modify inventory
    }

    match /categories/{id} {
      allow read: if true;                 // Domains are public
      allow write: if isAdmin();           // Only admin can reconfigure architecture
    }

    match /orders/{id} {
      allow create: if isApprovedRetailer(); // Only approved nodes can inject new orders
      allow read, update, delete: if isAdmin(); // Full telemetry control for admin
      allow read: if request.auth != null && request.auth.uid == resource.data.retailerId; // Self-monitoring for retailers
    }

    match /retailers/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid; // Initial node registration
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin(); // Node identification
      allow update: if isAdmin();          // Only admin can clear or quarantine nodes
      allow delete: if isAdmin();          // Only admin can purge nodes
    }

    match /admins/{uid} {
      allow read: if isAdmin();            // Admin identification
      allow write: if false;               // Master control only via Console
    }
  }
}
